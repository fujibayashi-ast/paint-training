{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Edit",
      "Write"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh issue create*)",
      "Bash(gh issue delete*)",
      "Bash(gh release create*)",
      "Bash(gh repo delete*)",
      "Bash(yarn publish*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(aws*)",
      "Bash(gcloud*)",
      "Bash(az*)",
      "Bash(kubectl*)",
      "Bash(terraform*)",
      "Bash(heroku*)",
      "Bash(flyctl*)",
      "Bash(fly*)",
      "Bash(vercel*)",
      "Bash(ssh*)",
      "Bash(scp*)",
      "Bash(rsync*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-credentials.sh"
          }
        ]
      }
    ]
  }
}
